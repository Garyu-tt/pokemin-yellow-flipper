 #include "../desktop_i.h"
 #include "desktop_view_main.h"
+#include "pika_desktop_sprites.h"
+#include "pika_glitchdex.h"
+
+/*
+ * Noosphere Pika desktop, replacing the visible Dolphin/Passport UX.
+ * Original full-body Pokemon Yellow sprites; private owner customization.
+ * The legacy dolphin backend is a compatibility dependency for core apps,
+ * NOT an animated character nor Passport in this fork.
+ */
+#define PIKA_STATS_PATH EXT_PATH("apps_data/yellow_pika/stats.txt")
+
+typedef struct {
+    bool card;
+    bool valid;
+    uint8_t gl_mode; /* 0 off / 1 list / 2 detail */
+    uint8_t gl_index;
+    uint8_t gl_id;
+    bool gl_active;
+    uint32_t tick;
+    uint32_t next_action;
+    uint32_t action_end;
+    uint32_t rng;
+    uint8_t action;
+    uint8_t hp_present;
+    uint16_t level;
+    uint16_t hp;
+    uint16_t hpmax;
+    uint32_t exp;
+    char nickname[12];
+    char status[12];
+} PikaDesktopModel;
 
 struct DesktopMainView {
     View* view;
+    View* locked_backdrop;
     DesktopMainViewCallback callback;
     void* context;
-    FuriTimer* _poweroff_timer; // Unused, kept for compatibility
-    bool _dummy_mode; // Unused, kept for compatibility
 };
 
+static uint32_t pika_rand(PikaDesktopModel* m) {
+    uint32_t x = m->rng ? m->rng : 0x19880912;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    m->rng = x;
+    return x;
+}
+
+static void pika_stats_reset(PikaDesktopModel* m) {
+    m->valid = false;
+    m->level = 0;
+    m->hp = 0;
+    m->hpmax = 0;
+    m->exp = 0;
+    strlcpy(m->nickname, "PIKACHU", sizeof(m->nickname));
+    strlcpy(m->status, "--", sizeof(m->status));
+}
+
+static void pika_stats_load(PikaDesktopModel* m) {
+    pika_stats_reset(m);
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* file = storage_file_alloc(storage);
+    bool source_ok = false;
+    bool committed = false;
+    bool level_ok = false, hp_ok = false, hpmax_ok = false, exp_ok = false;
+    if(storage_file_open(file, PIKA_STATS_PATH, FSAM_READ, FSOM_OPEN_EXISTING)) {
+        char buf[384] = {0};
+        size_t len = storage_file_read(file, buf, sizeof(buf) - 1);
+        buf[len] = '\0';
+        for(char* line = strtok(buf, "\r\n"); line; line = strtok(NULL, "\r\n")) {
+            char* equal = strchr(line, '=');
+            if(!equal) continue;
+            *equal++ = '\0';
+            if(!strcmp(line, "source")) source_ok = !strcmp(equal, "pokemon_yellow");
+            else if(!strcmp(line, "committed")) committed = !strcmp(equal, "1");
+            else if(!strcmp(line, "nickname")) {
+                unsigned n = 0;
+                for(unsigned i = 0; equal[i] && n < 10; ++i) {
+                    char c = equal[i];
+                    if(c >= 'a' && c <= 'z') c -= 32;
+                    if((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
+                        m->nickname[n++] = c;
+                    }
+                }
+                if(n) m->nickname[n] = '\0';
+            } else if(!strcmp(line, "level")) {
+                unsigned long v = strtoul(equal, NULL, 10);
+                if(v >= 1 && v <= 100) {m->level = v; level_ok = true;}
+            } else if(!strcmp(line, "hp")) {
+                unsigned long v = strtoul(equal, NULL, 10);
+                if(v <= 999) {m->hp = v; hp_ok = true;}
+            } else if(!strcmp(line, "hpmax")) {
+                unsigned long v = strtoul(equal, NULL, 10);
+                if(v >= 1 && v <= 999) {m->hpmax = v; hpmax_ok = true;}
+            } else if(!strcmp(line, "exp")) {
+                unsigned long v = strtoul(equal, NULL, 10);
+                if(v <= 9999999) {m->exp = v; exp_ok = true;}
+            } else if(!strcmp(line, "status")) {
+                unsigned i = 0;
+                for(; equal[i] && i < 10; ++i) {
+                    char c = equal[i];
+                    m->status[i] = (c >= ' ' && c <= '~') ? c : '_';
+                }
+                m->status[i] = '\0';
+            }
+        }
+    }
+    storage_file_close(file);
+    storage_file_free(file);
+    furi_record_close(RECORD_STORAGE);
+    m->valid = source_ok && committed && level_ok && hp_ok && hpmax_ok &&
+        exp_ok && m->hp <= m->hpmax;
+    if(!m->valid) pika_stats_reset(m);
+}
+
+static const YellowSprite* pika_choose(PikaDesktopModel* m) {
+    if(m->action && m->tick < m->action_end) {
+        switch(m->action) {
+        case 1: return &ys_emotion_side_1;
+        case 2: return &ys_emotion_happy_1;
+        case 3: return &ys_emotion_sleep_1;
+        case 4: return &ys_emotion_ear_twitch_1;
+        case 5: return &ys_emotion_joy_1;
+        default: break;
+        }
+    }
+    if(m->tick % 113 == 0 || m->tick % 113 == 1) return &ys_battle_front_blink;
+    return &ys_battle_front;
+}
+
+static void pika_picture(Canvas* canvas, const YellowSprite* sprite, int x, int y) {
+    canvas_set_color(canvas, ColorBlack);
+    canvas_set_bitmap_mode(canvas, true);
+    canvas_draw_xbm(canvas, x, y, sprite->w, sprite->h, sprite->data);
+}
+
+
+/* The invalid Yellow ROM sprite pointers are never executed here. */
+static void pika_glitch_sprite(uint8_t id,uint8_t out[200]) {
+    const uint8_t* bitmap=NULL;
+    if(id==0xB6)bitmap=glitch_kabutops;
+    else if(id==0xB7)bitmap=glitch_aerodactyl;
+    else if(id==0xB8)bitmap=glitch_ghost;
+    if(bitmap) {
+        memcpy(out,bitmap,200);
+        return;
+    }
+    /* Bounded deterministic reconstruction, labelled SAFE PREVIEW. */
+    uint32_t v=0x9E3779B9u ^ ((uint32_t)id*0x45D9F3Bu);
+    for(int i=0;i<200;i++) {
+        v^=v<<13;v^=v>>17;v^=v<<5;
+        out[i]=((i/5)%7)==0?(uint8_t)v:
+               (glitch_kabutops[(i+id)%200] ^ ((uint8_t)v&0x33u));
+    }
+}
+static void pika_glitch_art(Canvas* canvas,uint8_t id,int x,int y) {
+    uint8_t pixels[200];
+    pika_glitch_sprite(id,pixels);
+    canvas_set_color(canvas,ColorBlack);
+    canvas_set_bitmap_mode(canvas,false);
+    canvas_draw_xbm(canvas,x,y,40,40,pixels);
+    canvas_set_bitmap_mode(canvas,true);
+}
+static void pika_glitch_list(Canvas* canvas,const PikaDesktopModel* m) {
+    char txt[32];uint8_t ix=m->gl_index;
+    snprintf(txt,sizeof(txt),"GLITCHDEX %u/105",(unsigned)ix+1u);
+    canvas_draw_str(canvas,2,10,txt);
+    canvas_draw_line(canvas,1,12,127,12);
+    uint8_t first=(ix/4u)*4u;
+    for(uint8_t row=0;row<4;row++) {
+        uint8_t n=first+row;
+        if(n>=PIKA_GLITCH_COUNT)break;
+        uint8_t id=pika_glitch_id(n);
+        snprintf(txt,sizeof(txt),"%c %02X %.16s",n==ix?'>':' ',id,pika_glitch_name(id));
+        canvas_draw_str(canvas,2,22+row*10,txt);
+    }
+    canvas_draw_str(canvas,2,63,"OK VIEW  <> PAGE");
+}
+static void pika_glitch_detail(Canvas* canvas,const PikaDesktopModel* m) {
+    uint8_t id=pika_glitch_id(m->gl_index);
+    char txt[32];
+    snprintf(txt,sizeof(txt),"GLITCH ID 0x%02X",id);
+    canvas_draw_str(canvas,2,10,txt);
+    canvas_draw_line(canvas,1,12,127,12);
+    canvas_draw_str(canvas,2,24,pika_glitch_name(id));
+    canvas_draw_str(canvas,2,36,id>=0xB6&&id<=0xB8?"ORIGINAL ART":"SAFE PREVIEW");
+    canvas_draw_str(canvas,2,47,"NO ROM EXEC");
+    canvas_draw_str(canvas,2,62,"OK SUMMON");
+    pika_glitch_art(canvas,id,87,18);
+}
+static void pika_draw(Canvas* canvas, void* ctx) {
+    PikaDesktopModel* m = ctx;
+    canvas_clear(canvas);
+    canvas_set_color(canvas, ColorBlack);
+    canvas_set_font(canvas, FontSecondary);
+    if(m->gl_mode==1) {
+        pika_glitch_list(canvas,m);
+        return;
+    }
+    if(m->gl_mode==2) {
+        pika_glitch_detail(canvas,m);
+        return;
+    }
+    if(m->gl_active&&!m->card) {
+        char name[32];
+        const char* device=furi_hal_version_get_name_ptr();
+        canvas_draw_str(canvas,3,9,device?device:"FLIPPER");
+        canvas_draw_line(canvas,2,13,126,13);
+        snprintf(name,sizeof(name),"GLITCH %02X",m->gl_id);
+        canvas_draw_str(canvas,2,28,name);
+        canvas_draw_str(canvas,2,41,"SUMMONED");
+        canvas_draw_str(canvas,2,60,"BACK: PIKA");
+        pika_glitch_art(canvas,m->gl_id,85,16);
+        return;
+    }
+    if(m->card) {
+        canvas_draw_rframe(canvas, 0, 0, 128, 64, 3);
+        canvas_draw_str(canvas, 5, 10, "PIKACHU  #025");
+        canvas_draw_line(canvas, 4, 13, 123, 13);
+        pika_picture(canvas, &ys_battle_front, 5, 17);
+        char buffer[32];
+        canvas_draw_str(canvas, 50, 22, m->nickname);
+        if(m->valid) {
+            snprintf(buffer, sizeof(buffer), "LV %u", m->level);
+            canvas_draw_str(canvas, 50, 32, buffer);
+            snprintf(buffer, sizeof(buffer), "HP %u/%u", m->hp, m->hpmax);
+            canvas_draw_str(canvas, 50, 42, buffer);
+            snprintf(buffer, sizeof(buffer), "EXP %lu", (unsigned long)m->exp);
+            canvas_draw_str(canvas, 50, 52, buffer);
+            canvas_draw_str(canvas, 4, 61, m->status);
+        } else {
+            canvas_draw_str(canvas, 50, 32, "LV --");
+            canvas_draw_str(canvas, 50, 42, "HP --/--");
+            canvas_draw_str(canvas, 50, 52, "EXP --");
+            canvas_draw_str(canvas, 5, 61, "WAITING FOR YELLOW");
+        }
+    } else {
+        const char* device = furi_hal_version_get_name_ptr();
+        canvas_draw_str(canvas, 3, 9, device ? device : "PIKACHU");
+        canvas_draw_line(canvas, 2, 13, 62, 13);
+        canvas_draw_str(canvas, 3, 26, "PIKACHU #025");
+        if(m->valid) {
+            char buffer[28];
+            snprintf(buffer, sizeof(buffer), "LV %u", m->level);
+            canvas_draw_str(canvas, 3, 38, buffer);
+            snprintf(buffer, sizeof(buffer), "HP %u/%u", m->hp, m->hpmax);
+            canvas_draw_str(canvas, 3, 49, buffer);
+        } else {
+            canvas_draw_str(canvas, 3, 38, "LV --");
+            canvas_draw_str(canvas, 3, 49, "HP --");
+        }
+        canvas_draw_str(canvas, 3, 60, "RIGHT: CARD");
+        pika_picture(canvas, pika_choose(m), 80, 16);
+    }
+}
+
 void desktop_main_set_callback(
     DesktopMainView* main_view,
     DesktopMainViewCallback callback,
@@ -32,44 +282,133 @@ View* desktop_main_get_view(DesktopMainView* main_view) {
     return main_view->view;
 }
 
+View* desktop_main_get_locked_background(DesktopMainView* main_view) {
+    furi_assert(main_view);
+    return main_view->locked_backdrop;
+}
+
+void desktop_main_tick(DesktopMainView* main_view) {
+    if(!main_view) return;
+    PikaDesktopModel* m = view_get_model(main_view->view);
+    ++m->tick;
+    if(m->tick >= m->next_action && !m->card) {
+        uint32_t roll = pika_rand(m) % 100;
+        m->action = roll < 45 ? 0 : roll < 66 ? 1 : roll < 82 ? 2 :
+            roll < 89 ? 3 : roll < 95 ? 4 : 5;
+        m->action_end = m->tick + 2 + (pika_rand(m) % 7);
+        m->next_action = m->tick + 14 + (pika_rand(m) % 90);
+    }
+    view_commit_model(main_view->view, true);
+    PikaDesktopModel* lm = view_get_model(main_view->locked_backdrop);
+    lm->tick = m->tick;
+    lm->rng = m->rng;
+    lm->action = m->action;
+    lm->action_end = m->action_end;
+    view_commit_model(main_view->locked_backdrop, true);
+}
+
 bool desktop_main_input_callback(InputEvent* event, void* context) {
     furi_assert(event);
     furi_assert(context);
+    DesktopMainView* view = context;
+    PikaDesktopModel* model = view_get_model(view->view);
 
-    DesktopMainView* main_view = context;
-
-    if(event->type == InputTypeShort || event->type == InputTypeLong) {
-        if(event->key == InputKeyOk) {
-            main_view->callback(
-                event->type == InputTypeShort ? DesktopMainEventOpenMenu :
-                                                DesktopAnimationEventNewIdleAnimation,
-                main_view->context);
-        } else {
-            desktop_run_keybind((Desktop*)main_view->context, event->type, event->key);
+    if(event->key == InputKeyBack && event->type == InputTypeLong) {
+        view->callback(DesktopMainEventOpenPowerOff, view->context);
+        return true;
+    }
+    if(event->key == InputKeyOk && event->type == InputTypeLong) {
+        model->gl_mode=model->gl_mode?0:1;
+        view_commit_model(view->view,true);
+        return true;
+    }
+    if(model->gl_mode) {
+        if(event->type==InputTypeShort||event->type==InputTypeRepeat) {
+            if(model->gl_mode==1) {
+                if(event->key==InputKeyUp&&model->gl_index)model->gl_index--;
+                else if(event->key==InputKeyDown&&model->gl_index+1u<PIKA_GLITCH_COUNT)model->gl_index++;
+                else if(event->key==InputKeyLeft)model->gl_index=model->gl_index>8?model->gl_index-8:0;
+                else if(event->key==InputKeyRight)model->gl_index=model->gl_index+8u<PIKA_GLITCH_COUNT?model->gl_index+8u:PIKA_GLITCH_COUNT-1u;
+                else if(event->key==InputKeyOk)model->gl_mode=2;
+                else if(event->key==InputKeyBack)model->gl_mode=0;
+            } else if(model->gl_mode==2) {
+                if(event->key==InputKeyBack)model->gl_mode=1;
+                else if(event->key==InputKeyOk) {
+                    model->gl_id=pika_glitch_id(model->gl_index);
+                    model->gl_active=true;
+                    model->gl_mode=0;
+                    model->card=false;
+                }
+            }
+            view_commit_model(view->view,true);
         }
+        return true;
     }
-
-    if(event->key == InputKeyBack) {
-        if(event->type == InputTypeLong) {
-            main_view->callback(DesktopMainEventOpenPowerOff, main_view->context);
+    if(model->gl_active&&event->type==InputTypeShort&&event->key==InputKeyBack) {
+        model->gl_active=false;
+        model->card=false;
+        view_commit_model(view->view,true);
+        return true;
+    }
+    if(event->type == InputTypeShort && event->key == InputKeyRight) {
+        model->card = !model->card;
+        if(model->card) pika_stats_load(model);
+        view_commit_model(view->view, true);
+        return true;
+    }
+    if(model->card) {
+        if(event->type == InputTypeShort &&
+           (event->key == InputKeyBack || event->key == InputKeyLeft ||
+            event->key == InputKeyOk)) {
+            model->card = false;
+            view_commit_model(view->view, true);
+        }
+        return true;
+    }
+    if(event->type == InputTypeShort || event->type == InputTypeLong) {
+        if(event->key == InputKeyOk) {
+            if(event->type == InputTypeShort) {
+                view->callback(DesktopMainEventOpenMenu, view->context);
+            }
+            // Long OK is not a Dolphin animation shortcut anymore.
+        } else if(event->key != InputKeyBack) {
+            desktop_run_keybind((Desktop*)view->context, event->type, event->key);
         }
     }
-
     return true;
 }
 
 DesktopMainView* desktop_main_alloc(void) {
-    DesktopMainView* main_view = malloc(sizeof(DesktopMainView));
+    DesktopMainView* main = malloc(sizeof(DesktopMainView));
+    furi_check(main);
+    memset(main, 0, sizeof(DesktopMainView));
 
-    main_view->view = view_alloc();
-    view_set_context(main_view->view, main_view);
-    view_set_input_callback(main_view->view, desktop_main_input_callback);
+    main->view = view_alloc();
+    view_allocate_model(main->view, ViewModelTypeLockFree, sizeof(PikaDesktopModel));
+    view_set_context(main->view, main);
+    view_set_draw_callback(main->view, pika_draw);
+    view_set_input_callback(main->view, desktop_main_input_callback);
 
-    return main_view;
+    main->locked_backdrop = view_alloc();
+    view_allocate_model(main->locked_backdrop, ViewModelTypeLockFree, sizeof(PikaDesktopModel));
+    view_set_draw_callback(main->locked_backdrop, pika_draw);
+    // No input handler on locked background: PIN/keypad controls remain authoritative.
+    PikaDesktopModel* model = view_get_model(main->view);
+    memset(model, 0, sizeof(*model));
+    model->rng = furi_get_tick() ^ 0x40920819;
+    model->next_action = 20;
+    pika_stats_reset(model);
+    view_commit_model(main->view, true);
+    PikaDesktopModel* locked = view_get_model(main->locked_backdrop);
+    memset(locked, 0, sizeof(*locked));
+    pika_stats_reset(locked);
+    view_commit_model(main->locked_backdrop, true);
+    return main;
 }
 
 void desktop_main_free(DesktopMainView* main_view) {
     furi_assert(main_view);
+    view_free(main_view->locked_backdrop);
     view_free(main_view->view);
     free(main_view);
 }
