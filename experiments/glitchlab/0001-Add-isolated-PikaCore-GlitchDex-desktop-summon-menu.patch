@@ -1,22 +1,272 @@
 #include <gui/gui_i.h>
 #include <gui/view.h>
-#include <gui/elements.h>
 #include <gui/canvas.h>
 #include <furi.h>
+#include <furi_hal.h>
 #include <input/input.h>
-#include <dolphin/dolphin.h>
