diff --git a/applications/services/desktop/views/pika_desktop_sprites.h b/applications/services/desktop/views/pika_desktop_sprites.h
new file mode 100644
index 0000000..a554c19
--- /dev/null
+++ b/applications/services/desktop/views/pika_desktop_sprites.h
@@ -0,0 +1,21 @@
+#pragma once
